{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "noEmit": true,
    "outDir": "./src/renderer",
    "sourceMap": false,
    "types": [],
    "jsx": "preserve",
    "jsxImportSource": "solid-js"
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
